{
  "name": "bobplugin-explain",
  "version": "0.1.2",
  "description": "解释一下插件，自定义 Prompt + OpenAI 兼容接口",
  "homepage": "https://github.com/ifyour/bobplugin-explain",
  "repository": "https://github.com/ifyour/bobplugin-explain.git",
  "author": "ifyour",
  "license": "MIT",
  "main": "src/main.js",
  "keywords": [
    "bobplugin",
    "explain",
    "llm"
  ],
  "scripts": {
    "clear": "rm -rf ./dist ./release",
    "initInfo": "node ./scripts/init-info.js",
    "install": "npm run initInfo",
    "dev": "cross-env NODE_ENV=development rollup -c rollup.config.js --watch",
    "build": "npm run clear && npm run initInfo && NODE_ENV=production rollup -c && node ./scripts/build-zip.js",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "prettier:fix": "prettier --config .prettierrc.js --write .",
    "eslint": "eslint . -c .eslintrc.js --ext .ts,.tsx,.js",
    "eslint:fix": "eslint . -c .eslintrc.js --fix --ext .ts,.tsx,.js",
    "version": "npm run initInfo && git add CHANGELOG.md src/info.json"
  },
  "dependencies": {
    "@bob-plug/core": "^0.1.3"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.0.0",
    "@types/eslint-plugin-prettier": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "^4.28.2",
    "@typescript-eslint/parser": "^4.28.2",
    "adm-zip": "^0.5.5",
    "esbuild": "^0.12.15",
    "eslint": "^7.30.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-import-resolver-typescript": "^2.4.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^3.4.0",
    "prettier": "^2.3.2",
    "rollup": "^2.52.8",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-esbuild": "^4.5.0",
    "typescript": "^4.3.5"
  }
}
